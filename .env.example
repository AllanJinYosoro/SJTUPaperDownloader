# Sign in in the visible browser on the first download. Later set HEADLESS=true.
HEADLESS=false
PORT=8765
DOWNLOAD_DIR=downloads
BROWSER_PROFILE_DIR=.browser-profile
TASK_TIMEOUT_MS=600000
TITLE_MATCH_THRESHOLD=0.94

# Optional. Only submitted to https://jaccount.sjtu.edu.cn; never put these in a chat.
# Quote values containing spaces or #. The old Jaccount_PWD name is also accepted.
JACCOUNT_USERNAME=
JACCOUNT_PASSWORD=
